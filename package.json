{
  "name": "seraphinas-secret",
  "private": true,
  "version": "0.0.1",
  "description": "A cozy, no-fail 2D exploration game.",
  "type": "module",
  "scripts": {
    "assets:sync": "tsx tools/assets/sync.ts",
    "books:placeholders": "tsx tools/books/placeholders.ts",
    "predev": "npm run assets:sync",
    "prebuild": "npm run assets:sync",
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "voice:audit": "tsx tools/voice/audit.ts",
    "voice:batch": "tsx tools/voice/batch.ts",
    "voice:build": "tsx tools/voice/build.ts",
    "voice:ingest": "tsx tools/voice/ingest.ts",
    "voice:inspect": "tsx tools/voice/inspect.ts",
    "voice:simulate": "tsx tools/voice/simulate.ts",
    "voice:status": "tsx tools/voice/status.ts",
    "world:build": "tsx tools/world/build.ts",
    "world:measure": "tsx tools/world/measure.ts",
    "world:footings": "tsx tools/world/footings.ts",
    "test": "playwright test --grep-invert @slow",
    "test:slow": "playwright test --grep @slow",
    "test:all": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "edge-tts-universal": "^1.4.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "phaser": "^3.90.0"
  }
}
