{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // DOM is here only because inspect.ts ships a function into a Playwright
    // page to decode audio; nothing else in tools/ may touch a browser global.
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "module": "NodeNext",
    "moduleResolution": "nodenext"
  },
  // content/world is authored map layout, written in TypeScript because the
  // world is composed rather than transcribed. It is only ever read by
  // tools/world/build.ts, never by the game.
  "include": ["tools", "content"]
}
