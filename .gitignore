# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
*.local

# Licensed art, mirrored out of the side-load by `npm run assets:sync`. The pack
# may not be redistributed, so none of it may ever be committed. Disposable —
# delete the folder and the next `npm run dev` rebuilds it.
/public/assets/

# The screenshot tour's output. Regenerated every `npm test`, so committing it
# is committing the same megabytes again per run. Evidence screenshots are
# report appendices on the drive — see CLAUDE.md, "Screenshots". An image may be
# committed only where a test actually reads it back.
/tests/screenshots/

# The forced aligner's Python environment — 1.3 GB of torch, rebuilt from
# tools/voice/align/requirements.txt in a couple of minutes. See its README.
/tools/voice/align/.venv/

# Matt's Firefly drop folder: generated batch text, its sidecar, and the WAV he
# downloads. All three are INPUTS to the ingest, not build outputs — what gets
# committed is the finished clips under content/voice/clips/. See its README.
/voice-batches/*
!/voice-batches/README.md

# Working files: alignment dumps and cut audio, all regenerable by re-running
# the spike scripts. `scratch/` itself is a fine place for a file worth keeping.
/scratch/voice-align/

# What Matt marked while listening in the sound debug view, appended by the dev
# server. A record of one listening session, read by whatever prompt comes next
# and remade by listening again — see src/debug/SoundDebugScene.ts.
/scratch/voice-review.json

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
logs/
*.log

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Env
.env
.env.*
!.env.example

# Python bytecode from the forced aligner.
__pycache__/
*.pyc

# NOTE: reports do not live in this repo at all — they are written straight to
# C:\Code\seraphinas-drive-sync\reports\. See CLAUDE.md, "Report delivery".

